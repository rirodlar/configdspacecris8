    <!-- ============================================================ -->
    <!-- RELACIONES DE LA ENTIDAD TESIS                               -->
    <!--                                                              -->
    <!-- En DSpace CRIS, las relaciones permiten vincular ítems de    -->
    <!-- distintos tipos de entidades entre sí. Cada <type> define    -->
    <!-- una relación bidireccional: leftwardType es el nombre de la  -->
    <!-- relación vista desde la entidad izquierda (Tesis), y         -->
    <!-- rightwardType es el nombre visto desde la entidad derecha.   -->
    <!--                                                              -->
    <!-- copyToLeft/copyToRight controla si los metadatos del ítem    -->
    <!-- relacionado se "copian" virtualmente al otro extremo para    -->
    <!-- enriquecer la visualización sin duplicar datos reales.       -->
    <!-- ============================================================ -->

    <!-- Relación Tesis ↔ Person (autor/a de la tesis).
         Una tesis puede tener uno o más autores (Person).
         copyToLeft=true: los datos de la Person se reflejan en la Tesis. -->
    <type>
        <leftType>Tesis</leftType>
        <rightType>Person</rightType>
        <leftwardType>isAuthorOfTesis</leftwardType>
        <rightwardType>isTesisOfAuthor</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>true</copyToLeft>
    </type>

    <!-- Relación Tesis ↔ Project (proyecto que financió/generó la tesis).
         Permite vincular la tesis con proyectos de investigación. -->
    <type>
        <leftType>Tesis</leftType>
        <rightType>Project</rightType>
        <leftwardType>isProjectOfTesis</leftwardType>
        <rightwardType>isTesisOfProject</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>true</copyToLeft>
    </type>

    <!-- Relación Tesis ↔ OrgUnit (departamento/facultad de origen).
         Permite asociar la tesis con la unidad académica que la generó. -->
    <type>
        <leftType>Tesis</leftType>
        <rightType>OrgUnit</rightType>
        <leftwardType>isOrgUnitOfTesis</leftwardType>
        <rightwardType>isTesisOfOrgUnit</rightwardType>
        <leftCardinality>
            <min>0</min>
        </leftCardinality>
        <rightCardinality>
            <min>0</min>
        </rightCardinality>
        <copyToLeft>true</copyToLeft>
    </type>

</relationships>